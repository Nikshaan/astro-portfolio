---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
---

<MainLayout
    title="404 - Page Not Found | Nikshaan"
    description="The page you're looking for doesn't exist. Return to homepage."
>
    <div class="min-h-[100svh] w-full bg-[var(--surface-page)] text-[var(--text-primary)] flex flex-col justify-center items-center gap-4 p-4">
        <h1 class="type-hero-display">404</h1>
        <p class="type-h4 font-normal text-[var(--text-secondary)]">Page does not exist!</p>
        <a
            class="cursor-pointer px-6 py-3 bg-[var(--accent)] text-[var(--accent-contrast)] hover:opacity-90 rounded-full transition-opacity type-body font-bold"
            href="/"
            aria-label="Go back home"
        >
            Go back home
        </a>
    </div>
</MainLayout>
