---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
import NavbarWrapper from "../components/NavbarWrapper.astro";
import ProjectsBentoGridWrapper from "../components/ProjectsBentoGridWrapper.astro";
import FunBentoGridWrapper from "../components/FunBentoGridWrapper.astro";

import MeBentoGridWrapper from "../components/MeBentoGridWrapper.astro";
import beeImage from "../data/bee.avif";
import nikshaanRaw from "../data/NIKSHAAN.avif";
import { getImage } from "astro:assets";

export const prerender = true;

const optimizedBeeImage = await getImage({
  src: beeImage,
  format: "avif",
  widths: [320, 640, 768, 1024, 1280],
  width: 313,
  quality: 95,
});

const optimizedProfileImage = await getImage({
  src: nikshaanRaw,
  format: "avif",
  width: 400,
  quality: 85,
});
---

<script is:inline>
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }
  var nav = performance.getEntriesByType("navigation")[0];
  if (!nav || nav.type !== "back_forward") {
    window.scrollTo(0, 0);
  }
</script>

<MainLayout
  title="Nikshaan | Portfolio"
  description="I am a developer based in Mumbai, India. I am passionate about machine learning, deep learning and web development. This portfolio is made using astro and has a bento box style."
  preloadImage={optimizedBeeImage.src}
  profileImage={optimizedProfileImage.src}
>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <NavbarWrapper />
  <main
    id="main-content"
    class="bg-[var(--surface-page)] text-[var(--text-primary)] min-h-[100svh] w-full flex items-center flex-col"
  >
    <div class="w-full flex flex-col justify-start items-center gap-16 pb-16 pt-24">
      <section
        id="me"
        class="w-full max-w-[1400px] px-4"
        data-section="me"
        aria-labelledby="me-heading"
      >
        <MeBentoGridWrapper beeImage={optimizedBeeImage} />
      </section>

      <section
        id="projects"
        class="w-full flex flex-col gap-2 flex-1"
        aria-labelledby="projects-heading"
      >
        <ProjectsBentoGridWrapper />
      </section>

      <section
        id="fun"
        class="w-full flex flex-col lg:flex-row gap-2 flex-1"
        data-section="fun"
        aria-labelledby="fun-heading"
      >
        <FunBentoGridWrapper />
      </section>
    </div>
  </main>
</MainLayout>

<style>
  .save-data img {
    image-rendering: auto;
  }
  .save-data video:not(.project-demo-video) {
    display: none;
  }
</style>
