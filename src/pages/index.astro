---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
import NavbarWrapper from "../components/NavbarWrapper.astro";
import ProjectsBentoGridWrapper from "../components/ProjectsBentoGridWrapper.astro";
import FunBentoGridWrapper from "../components/FunBentoGridWrapper.astro";

import MeBentoGridWrapper from "../components/MeBentoGridWrapper.astro";
import beeImage from "../data/bee.avif";
import { getImage } from "astro:assets";
import { BEE_IMAGE_SIZES } from "../lib/imageSizes";

export const prerender = true;

const optimizedBeeImage = await getImage({
  src: beeImage,
  format: "avif",
  widths: [140, 180, 210, 280, 360, 420],
  width: 210,
  quality: 82,
});
---

<script is:inline>
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }
  var nav = performance.getEntriesByType("navigation")[0];
  if (!nav || nav.type !== "back_forward") {
    window.scrollTo(0, 0);
  }
</script>

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL || "/" }}>
  if (typeof window !== "undefined") {
    var prewarm = function () {
      var prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
      var urls = [
        prefix + "api/github-contributions",
        prefix + "api/music-stats",
        prefix + "api/music-radial-heatmap",
        prefix + "api/oss-contributions",
        prefix + "api/llm-from-scratch-stars",
        prefix + "india-topo.json",
      ];
      urls.forEach(function (url) {
        try {
          fetch(url, { priority: "low", headers: { Accept: "application/json" } }).catch(function () {});
        } catch (e) {}
      });
    };
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(prewarm, { timeout: 2500 });
    } else {
      setTimeout(prewarm, 1800);
    }
  }
</script>

<script is:inline>
  (function () {
    if (typeof window === "undefined" || !("IntersectionObserver" in window)) return;

    function init() {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
            var el = entry.target;
            // Pin the revealed state once the CSS reveal (0.4s) has had
            // time to finish, so cards never fade out again on scroll-up.
            window.setTimeout(function () {
              el.classList.add("bento-revealed");
            }, 450);
          });
        },
        { threshold: 0, rootMargin: "80px 0px -10% 0px" },
      );

      document.querySelectorAll(".bento-reveal").forEach(function (el) {
        observer.observe(el);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

<MainLayout
  title="Nikshaan | Portfolio"
  description="I am a developer based in Mumbai, India. I am passionate about machine learning, deep learning and web development. This portfolio is made using astro and has a bento box style."
  preloadImageSrc={optimizedBeeImage.src}
  preloadImageSrcSet={optimizedBeeImage.srcSet?.attribute}
  preloadImageSizes={BEE_IMAGE_SIZES}
>
  <NavbarWrapper />
  <main
    id="main-content"
    class="bg-[var(--surface-page)] text-[var(--text-primary)] min-h-[100svh] w-full flex items-center flex-col"
  >
    <div class="w-full flex flex-col justify-start items-center gap-16 pb-16 pt-24">
      <section
        id="me"
        class="w-full max-w-[1400px] px-4 scroll-mt-20"
        data-section="me"
        aria-labelledby="me-heading"
      >
        <MeBentoGridWrapper beeImage={optimizedBeeImage} />
      </section>

      <section
        id="projects"
        class="w-full flex flex-col gap-2 flex-1 scroll-mt-20"
        aria-labelledby="projects-heading"
      >
        <ProjectsBentoGridWrapper />
      </section>

      <section
        id="fun"
        class="w-full flex flex-col lg:flex-row gap-2 flex-1 scroll-mt-20"
        data-section="fun"
        aria-labelledby="fun-heading"
      >
        <FunBentoGridWrapper />
      </section>
    </div>
  </main>
</MainLayout>

<style>
  .save-data img {
    image-rendering: auto;
  }
  .save-data video:not(.project-demo-video) {
    display: none;
  }
</style>
