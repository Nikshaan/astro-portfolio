---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/global.css";
import NavbarWrapper from "../components/NavbarWrapper.astro";
import ProjectsBentoGridWrapper from "../components/ProjectsBentoGridWrapper.astro";
import FunBentoGridWrapper from "../components/FunBentoGridWrapper.astro";

import MeBentoGridWrapper from "../components/MeBentoGridWrapper.astro";
import WritingBentoGridWrapper from "../components/WritingBentoGridWrapper.astro";
import beeImage from "../data/bee.avif";
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { BEE_IMAGE_SIZES } from "../lib/imageSizes";
import { comparePostsNewestFirst } from "../lib/blogArchive";

export const prerender = true;

const publishedPosts = await getCollection("blog", ({ data }) => !data.draft);
const hasPublishedPosts = publishedPosts.length > 0;
const blogPrerenderUrls = [...publishedPosts]
  .sort(comparePostsNewestFirst)
  .slice(0, 3)
  .map((post) => `/blog/${post.id}/`);

const optimizedBeeImage = await getImage({
  src: beeImage,
  format: "avif",
  widths: [140, 180, 210, 280, 360, 420],
  width: 210,
  quality: 82,
});
---

<script is:inline>
  (function () {
    var nav = performance.getEntriesByType("navigation")[0];
    var type = nav ? nav.type : "navigate";

    if ("scrollRestoration" in history) {
      history.scrollRestoration = "auto";
    }

    if (type === "reload") {
      window.scrollTo(0, 0);
    }

    if (type === "back_forward" || location.hash) return;

    var root = document.documentElement;
    var events = ["scroll", "pointerdown", "keydown", "touchstart"];
    var release = function () {
      root.classList.remove("blogs-held");
      for (var i = 0; i < events.length; i++) {
        window.removeEventListener(events[i], release, true);
      }
    };
    root.classList.add("blogs-held");
    for (var i = 0; i < events.length; i++) {
      window.addEventListener(events[i], release, { capture: true, passive: true });
    }
    window.addEventListener("load", function () { setTimeout(release, 0); }, { once: true });
    window.addEventListener("hashchange", release, { once: true });
  })();
</script>

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL || "/" }}>
  if (typeof window !== "undefined") {
    var prewarm = function () {
      var prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
      var urls = [
        prefix + "api/github-contributions",
        prefix + "api/music-stats",
        prefix + "api/music-radial-heatmap",
        prefix + "api/oss-contributions",
        prefix + "api/llm-from-scratch-stars",
        prefix + "india-topo.json",
      ];
      urls.forEach(function (url) {
        try {
          fetch(url, { priority: "low", headers: { Accept: "application/json" } }).catch(function () {});
        } catch (e) {}
      });
    };
    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(prewarm, { timeout: 2500 });
    } else {
      setTimeout(prewarm, 1800);
    }
  }
</script>

<MainLayout
  title="Nikshaan | Portfolio"
  description="I am a developer based in Mumbai, India. I am passionate about machine learning, deep learning and web development. This portfolio is made using astro and has a bento box style."
  preloadImageSrc={optimizedBeeImage.src}
  preloadImageSrcSet={optimizedBeeImage.srcSet?.attribute}
  preloadImageSizes={BEE_IMAGE_SIZES}
>
  <NavbarWrapper />
  <main
    id="main-content"
    class="bg-[var(--surface-page)] text-[var(--text-primary)] min-h-[100svh] w-full flex items-center flex-col"
  >
    <div class="w-full flex flex-col justify-start items-center gap-16 pb-16 pt-24">
      <section
        id="me"
        class="w-full max-w-[1400px] px-4 scroll-mt-20"
        data-section="me"
        aria-labelledby="me-heading"
      >
        <MeBentoGridWrapper beeImage={optimizedBeeImage} />
      </section>

      {hasPublishedPosts && (
        <section
          id="blogs"
          class="blogs-section w-full flex flex-col gap-2 flex-1 scroll-mt-20"
          data-section="blogs"
          aria-labelledby="blogs-heading"
        >
          <WritingBentoGridWrapper />
        </section>
      )}

      <section
        id="projects"
        class="w-full flex flex-col gap-2 flex-1 scroll-mt-20"
        aria-labelledby="projects-heading"
      >
        <ProjectsBentoGridWrapper />
      </section>

      <section
        id="fun"
        class="w-full flex flex-col lg:flex-row gap-2 flex-1 scroll-mt-20"
        data-section="fun"
        aria-labelledby="fun-heading"
      >
        <FunBentoGridWrapper />
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;

      var hash = window.location.hash;
      var navEntry = performance.getEntriesByType("navigation")[0];
      var shouldAlignToBlogs = hash === "#blogs" && (!navEntry || navEntry.type === "navigate");

      if (shouldAlignToBlogs) {
        if ("scrollRestoration" in history) {
          history.scrollRestoration = "manual";
        }

        function instantAlignToBlogs() {
          var el = document.getElementById("blogs");
          if (!el) return;
          var rect = el.getBoundingClientRect();
          var targetY = window.scrollY + rect.top - 80;
          if (Math.abs(rect.top - 80) > 4) {
            window.scrollTo({ top: Math.max(0, targetY), behavior: "instant" });
          }
        }

        instantAlignToBlogs();

        if (window.portfolioNav) {
          window.portfolioNav.pin(function () {
            var el = document.getElementById("blogs");
            return el ? Math.max(0, Math.round(el.getBoundingClientRect().top + window.scrollY - 80)) : NaN;
          }, 1500)();
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", instantAlignToBlogs, { once: true });
        }

        window.addEventListener("pageshow", function () {
          instantAlignToBlogs();
          setTimeout(function () {
            if ("scrollRestoration" in history) {
              history.scrollRestoration = "auto";
            }
          }, 150);
        }, { once: true });

        document.addEventListener("astro:page-load", instantAlignToBlogs);
        document.addEventListener("astro:after-swap", instantAlignToBlogs);
      }

      window.addEventListener("hashchange", function () {
        if (window.location.hash === "#blogs") {
          var el = document.getElementById("blogs");
          if (el) {
            el.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      });
    })();
  </script>

  <script is:inline define:vars={{ blogPrerenderUrls }}>
    (function () {
      var urls = blogPrerenderUrls;
      if (!urls || !urls.length || !window.HTMLScriptElement) return;
      try {
        if (navigator.connection && navigator.connection.saveData) return;
      } catch (e) {}
      var start = function () {
        if (document.querySelector("script[data-blog-prerender]")) return;
        var rules = document.createElement("script");
        rules.type = "speculationrules";
        rules.setAttribute("data-blog-prerender", "");
        rules.textContent = JSON.stringify({
          prerender: [{ urls: [urls[0]], eagerness: "immediate" }],
        });
        document.head.appendChild(rules);
      };
      var whenIdle = function (fn) {
        if ("requestIdleCallback" in window) requestIdleCallback(fn, { timeout: 1000 });
        else setTimeout(fn, 200);
      };
      var afterLoad = function (fn) {
        if (document.readyState === "complete") fn();
        else window.addEventListener("load", fn, { once: true });
      };
      var section = document.getElementById("blogs");
      if (!section || !("IntersectionObserver" in window)) {
        afterLoad(function () { setTimeout(start, 3000); });
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          if (!entries.some(function (e) { return e.isIntersecting; })) return;
          io.disconnect();
          afterLoad(function () { whenIdle(start); });
        },
        { rootMargin: "50% 0px" },
      );
      io.observe(section);
    })();
  </script>
</MainLayout>

<style>
  .blogs-section {
    content-visibility: auto;
    contain-intrinsic-size: auto 264px;
    overflow-clip-margin: 48px;
  }
  @media (min-width: 640px) {
    .blogs-section {
      contain-intrinsic-size: auto 253px;
    }
  }
  @media (min-width: 1280px) {
    .blogs-section {
      contain-intrinsic-size: auto 232px;
    }
  }

  .save-data img {
    image-rendering: auto;
  }
  .save-data video:not(.project-demo-video) {
    display: none;
  }

  @media (max-width: 1023px) {
    html.blogs-held .blogs-section {
      content-visibility: hidden;
    }
  }

  html.restore-pending .blogs-section {
    content-visibility: visible;
  }
</style>
