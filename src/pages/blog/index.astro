---
import { tagSlug } from "../../utils/tagSlug";
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import NavbarWrapper from "../../components/NavbarWrapper.astro";
import BlogSearch from "../../components/blog/BlogSearch";
import { getReadingTime } from "../../utils/readingTime";

const isDev = import.meta.env.DEV;
const allPosts = await getCollection("blog", ({ data }) => (isDev ? true : !data.draft));

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Collect all unique tags for the tag pills
const allTags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags || []))).sort();
---

<MainLayout
  title="Blogs & Engineering Notes | Nikshaan Shetty"
  description="Engineering postmortems, architecture breakdowns, and technical articles on AI/ML and software engineering."
  noindex={allPosts.length === 0}
  preloadMonoFont
>
  <NavbarWrapper />

  <main id="main-content" class="bg-[var(--surface-page)] text-[var(--text-primary)] min-h-[100svh] w-full pt-24 pb-20 px-4">
    <div class="w-full max-w-[1400px] mx-auto min-w-0">
      {/* Go Back Link */}
      <div class="mb-8">
        <a
          id="back-to-home-link"
          href="/#blogs"
          data-astro-prefetch="hover"
          class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors focus-visible:outline-none cursor-pointer group"
          aria-label="Go back to portfolio homepage where you left off"
        >
          <svg class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Go back</span>
        </a>
      </div>

      {/* Header */}
      <header class="mb-12">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] mb-3 break-words">
          Blogs
        </h1>

        <div class="mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <BlogSearch client:idle />
          {allTags.length > 0 && (
            <a
              href="/blog/tags"
              class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors self-start sm:self-center"
            >
              Browse all tags ({allTags.length}) →
            </a>
          )}
        </div>
      </header>

      {/* Posts List */}
      {sortedPosts.length === 0 ? (
        <div class="p-12 text-center rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-card)]">
          <p class="text-base text-[var(--text-secondary)]">No posts published yet.</p>
          <a
            href="/"
            class="inline-block mt-4 px-4 py-2 text-xs font-mono uppercase tracking-wider rounded-[var(--radius-control)] bg-[var(--accent)] text-[var(--accent-contrast)] hover:opacity-90 transition-opacity"
          >
            ← Return to portfolio
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 min-w-0">
          {sortedPosts.map((post) => {
            const readingStats = getReadingTime(post.body || "");
            const formattedDate = new Intl.DateTimeFormat("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            }).format(post.data.pubDate);

            return (
              <article class="group relative rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-card)] p-5 sm:p-6 transition-all duration-200 hover:border-[var(--border-strong)] hover:-translate-y-0.5 active:scale-[0.99] active:transition-transform active:duration-75 min-w-0 max-w-full overflow-hidden flex flex-col justify-between h-full">
                <a href={`/blog/${post.id}`} class="absolute inset-0 z-10" aria-label={`Read ${post.data.title}`} data-astro-prefetch="hover">
                  <span class="sr-only">Read {post.data.title}</span>
                </a>

                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[var(--text-tertiary)] mb-2.5">
                    <div class="flex items-center gap-2">
                      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                      <span>•</span>
                      <span>{readingStats.text}</span>
                    </div>
                    {post.data.draft && (
                      <span class="px-2 py-0.5 rounded bg-[var(--danger-quiet)] text-[var(--danger)] border border-[var(--danger)] text-xs uppercase tracking-wider font-semibold">
                        Draft
                      </span>
                    )}
                  </div>

                  <h2 class="font-heading text-lg sm:text-xl font-bold tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors mb-2 break-words">
                    {post.data.title}
                  </h2>

                  <p class="text-sm text-[var(--text-secondary)] leading-relaxed line-clamp-2 mb-4 font-normal break-words">
                    {post.data.description}
                  </p>
                </div>

                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="relative z-20 flex flex-wrap gap-1.5 mt-auto pt-2">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <a
                        href={`/blog/tags/${tagSlug(tag)}`}
                        class="text-xs px-2.5 py-0.5 rounded-[var(--radius-control)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors font-mono"
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;

      function setupBackButton() {
        var backBtn = document.getElementById("back-to-home-link");
        if (!backBtn) return;

        backBtn.onclick = function () {
          try {
            sessionStorage.setItem("portfolio_return_to", "blogs");
          } catch (err) {}
        };
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupBackButton);
      } else {
        setupBackButton();
      }

      document.addEventListener("astro:page-load", setupBackButton);
      document.addEventListener("astro:after-swap", setupBackButton);
    })();
  </script>
</MainLayout>
