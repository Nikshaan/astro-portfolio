---
import { getCollection } from "astro:content";
import WritingBentoGrid from "./WritingBentoGrid";
import type { WritingPostSummary } from "./WritingBentoGrid";
import { getReadingTime } from "../utils/readingTime";

const publishedPosts = await getCollection("blog", ({ data }) => !data.draft);

const sortedPosts = [...publishedPosts].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  if (a.data.featured && b.data.featured) {
    const orderA = a.data.featuredOrder ?? Infinity;
    const orderB = b.data.featuredOrder ?? Infinity;
    if (orderA !== orderB) return orderA - orderB;
  }

  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});

const topPosts: WritingPostSummary[] = sortedPosts.slice(0, 3).map((post) => {
  const readingStats = getReadingTime(post.body || "");
  const formattedDate = new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(post.data.pubDate);

  return {
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: formattedDate,
    readingTime: readingStats.text,
    tags: post.data.tags || [],
  };
});
---

{topPosts.length > 0 && <WritingBentoGrid client:visible posts={topPosts} />}
