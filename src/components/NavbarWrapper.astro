---
import Navbar from "./Navbar";
---

<Navbar client:idle />

<style is:global>
  .nav-link {
    position: relative;
    color: var(--text-secondary);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }

  .nav-link.active:hover {
    color: var(--accent);
  }

  .nav-link,
  #theme-toggle {
    transition:
      color 0.2s ease-in-out,
      background-color 0.2s ease-in-out;
  }
</style>
