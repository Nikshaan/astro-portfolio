---
import FunBentoGrid from "./FunBentoGrid";
import { getImage } from "astro:assets";
import { photoTitles } from "../data/photoTitles";
import { photoOrderRank } from "../data/photoOrder";

const photoModules = import.meta.glob("../data/photos/photo*.webp");

const sortedModules = Object.entries(photoModules)
    .sort(([a], [b]) => {
        const aNum = parseInt(a.match(/photo(\d+)/)?.[1] || "0");
        const bNum = parseInt(b.match(/photo(\d+)/)?.[1] || "0");
        return photoOrderRank(aNum) - photoOrderRank(bNum);
    })
    .slice(0, 7);

const gridImages = await Promise.all(
    sortedModules.map(async ([path, importFunc]) => {
        const photoNumber = parseInt(path.match(/photo(\d+)/)?.[1] || "0");
        const imageModule = (await importFunc()) as any;
        if (!imageModule.default) return null;

        const optimizedThumbnail = await getImage({
            src: imageModule.default,
            widths: [380, 560, 760],
            width: 380,
            quality: 80,
            format: "webp",
            placeholder: "blur",
        });

        const optimizedFull = await getImage({
            src: imageModule.default,
            width: 1200,
            quality: 85,
            format: "webp",
        });

        return {
            id: `photo-${photoNumber}`,
            src: optimizedThumbnail.src,
            srcSet: optimizedThumbnail.srcSet?.attribute,
            fullSrc: optimizedFull.src,
            width: optimizedThumbnail.attributes.width,
            height: optimizedThumbnail.attributes.height,
            title: photoTitles[photoNumber] || `Photo ${photoNumber}`,
            alt: `Photography - ${photoTitles[photoNumber] || "Photo " + photoNumber}`,
            placeholderDataUrl:
                optimizedThumbnail.attributes.placeholder &&
                optimizedThumbnail.attributes.placeholder.startsWith("data:")
                    ? optimizedThumbnail.attributes.placeholder
                    : undefined,
        };
    }),
);

const validImages = gridImages.filter(
    (img): img is NonNullable<typeof img> => img !== null,
);
---

<FunBentoGrid client:visible images={validImages} />
