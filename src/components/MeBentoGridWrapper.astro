---
import MeBentoGrid from "./MeBentoGrid";
import { getImage } from "astro:assets";
import collegeLogo from "../data/djsce-logo.avif";
import aryaLogo from "../data/arya.avif";
import codeAIlogo from "../data/codeai.avif";
import varakLogo from "../data/varak.avif";
import mentoriaLogo from "../data/mentoria.avif";
import gssocLogo from "../data/gssoc.avif";
import winIcon from "../data/winIcon.avif";

const { beeImage } = Astro.props;

const optimizedImages = {
    beeImage: beeImage,
    collegeLogo: await getImage({
        src: collegeLogo,
        format: "avif",
        widths: [60, 120, 180],
        width: 180,
        quality: 80,
    }),
    aryaLogo: await getImage({
        src: aryaLogo,
        format: "avif",
        widths: [60, 120, 180],
        width: 180,
        quality: 80,
    }),
    codeAIlogo: await getImage({
        src: codeAIlogo,
        format: "avif",
        widths: [60, 120, 180],
        width: 180,
        quality: 80,
    }),
    varakLogo: await getImage({
        src: varakLogo,
        format: "avif",
        widths: [60, 120, 180],
        width: 180,
        quality: 80,
    }),
    mentoriaLogo: await getImage({
        src: mentoriaLogo,
        format: "avif",
        widths: [60, 120, 180],
        width: 180,
        quality: 80,
    }),
    gssocLogo: await getImage({
        src: gssocLogo,
        format: "avif",
        widths: [60, 120, 180],
        width: 180,
        quality: 80,
    }),
    winIcon: await getImage({
        src: winIcon,
        format: "avif",
        widths: [60, 120, 180],
        width: 180,
        quality: 80,
    }),
};
---

<h1 id="me-heading" class="sr-only">Nikshaan Shetty — AI/ML engineer & software developer, Mumbai, India</h1>
<h2 class="sr-only">About Me</h2>
<MeBentoGrid client:idle optimizedImages={optimizedImages} />
