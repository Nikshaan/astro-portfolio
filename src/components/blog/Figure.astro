---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  shotWidth?: number;
  desktop?: boolean;
  loading?: "lazy" | "eager";
}

const { src, alt, caption, shotWidth, desktop = false, loading = "lazy" } = Astro.props;

const CANDIDATE_WIDTHS = [480, 640, 960, 1280, 1600, 2000, 2400];
const widths = [...CANDIDATE_WIDTHS.filter((w) => w < src.width * 0.9), src.width];

const columnSizes = "(min-width: 1432px) 1038px, (min-width: 1024px) calc(75vw - 36px), calc(100vw - 32px)";
const desktopWidth = 576;

let sizes = columnSizes;
if (shotWidth) {
  sizes = `(min-width: ${shotWidth + 32}px) ${shotWidth}px, calc(100vw - 32px)`;
  if (desktop) sizes = `(min-width: 1024px) ${Math.min(shotWidth, desktopWidth)}px, ${sizes}`;
}
---

<figure
  class:list={[shotWidth && "post-figure-shot", desktop && "post-figure-desktop"]}
  style={shotWidth ? `--shot-width: ${shotWidth}px` : undefined}
>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={["avif"]}
    fallbackFormat="webp"
    loading={loading}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
