---
import { tagSlug } from "../../utils/tagSlug";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <div data-pagefind-ignore>
    <div class="mb-3 font-heading text-xs uppercase tracking-wider text-[var(--text-tertiary)] font-semibold flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
      Tags
    </div>
    <ul class="flex flex-wrap gap-2 m-0 p-0 list-none">
      {tags.map((tag) => (
        <li>
          <a
            href={`/blog/tags/${tagSlug(tag)}/`}
            class="text-xs px-2.5 py-0.5 rounded-[var(--radius-control)] border border-[var(--border-subtle)] bg-[var(--surface-card)] text-[var(--text-secondary)] hover:text-[var(--accent)] hover:border-[var(--accent)] transition-colors font-mono"
          >
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
