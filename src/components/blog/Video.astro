---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  poster: ImageMetadata;
  width: number;
  height: number;
  label: string;
  caption?: string;
  mode?: "demo" | "loop";
  av1?: boolean;
  posterLoading?: "eager" | "lazy";
  av1Codec?: string;
  h264Codec?: string;
}

const {
  src,
  poster,
  width,
  height,
  label,
  caption,
  mode = "demo",
  av1 = true,
  posterLoading = "lazy",
  av1Codec = "av01.0.05M.08",
  h264Codec = "avc1.640028",
} = Astro.props;

const posterImage = await getImage({
  src: poster,
  format: "avif",
  width: Math.min(poster.width, width),
});
const posterAttrs =
  posterLoading === "eager" ? { poster: posterImage.src } : { "data-poster": posterImage.src };
---

<figure class:list={["post-video", mode === "loop" && "post-video-loop"]}>
  {mode === "loop" ? (
    <div class="post-video-frame">
      <video
        class="project-demo-video"
        data-loop-video
        muted
        loop
        playsinline
        preload="none"
        {...posterAttrs}
        width={width}
        height={height}
        aria-label={label}
      >
        {av1 && <source src={`${src}.av1.mp4`} type={`video/mp4; codecs="${av1Codec}"`} />}
        <source src={`${src}.mp4`} type={`video/mp4; codecs="${h264Codec}"`} />
      </video>
      <button type="button" class="post-video-toggle" data-loop-toggle aria-pressed="false" hidden>
        <svg class="post-video-icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1"></rect>
          <rect x="14" y="5" width="4" height="14" rx="1"></rect>
        </svg>
        <svg class="post-video-icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path>
        </svg>
        <span class="post-video-toggle-label">Pause animation</span>
      </button>
    </div>
  ) : (
    <video
      class="project-demo-video"
      controls
      playsinline
      preload="none"
      {...posterAttrs}
      width={width}
      height={height}
      aria-label={label}
    >
      {av1 && <source src={`${src}.av1.mp4`} type={`video/mp4; codecs="${av1Codec}"`} />}
      <source src={`${src}.mp4`} type={`video/mp4; codecs="${h264Codec}"`} />
    </video>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style is:global>
  .post-prose figure.post-video {
    margin: 2em 0;
  }

  .post-prose figure.post-video video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background-color: #0a0a0a;
  }

  .post-video-frame {
    position: relative;
    width: 100%;
  }

  .post-video-toggle {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--surface-raised) 88%, transparent);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: border-color 150ms ease, color 150ms ease;
  }

  .post-video-toggle[hidden] {
    display: none;
  }

  .post-video-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .post-video-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .post-video-toggle svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .post-video-toggle[data-state="playing"] .post-video-icon-play,
  .post-video-toggle:not([data-state="playing"]) .post-video-icon-pause {
    display: none;
  }
</style>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function initLoopVideos() {
    document.querySelectorAll<HTMLElement>(".post-video-loop").forEach((figure) => {
      if (figure.dataset.bound) return;
      figure.dataset.bound = "true";

      const video = figure.querySelector<HTMLVideoElement>("[data-loop-video]");
      const toggle = figure.querySelector<HTMLButtonElement>("[data-loop-toggle]");
      const label = toggle?.querySelector(".post-video-toggle-label");
      if (!video || !toggle || !label) return;

      let pausedByUser = reducedMotion.matches;
      let inView = false;

      const render = () => {
        const playing = !video.paused;
        toggle.setAttribute("aria-pressed", String(!playing));
        toggle.dataset.state = playing ? "playing" : "paused";
        label.textContent = playing ? "Pause animation" : "Play animation";
      };

      const sync = () => {
        if (!pausedByUser && inView) video.play().catch(() => render());
        else video.pause();
      };

      video.addEventListener("play", render);
      video.addEventListener("pause", render);

      toggle.addEventListener("click", () => {
        pausedByUser = !video.paused;
        sync();
      });

      reducedMotion.addEventListener("change", (event) => {
        if (event.matches) {
          pausedByUser = true;
          sync();
        }
      });

      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        sync();
      }).observe(video);

      toggle.hidden = false;
      render();
      sync();
    });
  }

  const posterObserver =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const video = entry.target as HTMLVideoElement;
              posterObserver?.unobserve(video);
              video.poster = video.dataset.poster ?? "";
            }
          },
          { rootMargin: "100% 0px" },
        )
      : null;

  function initLazyPosters() {
    document.querySelectorAll<HTMLVideoElement>("video[data-poster]").forEach((video) => {
      if (video.dataset.posterBound) return;
      video.dataset.posterBound = "true";
      if (posterObserver) posterObserver.observe(video);
      else video.poster = video.dataset.poster ?? "";
    });
  }

  function init() {
    initLazyPosters();
    initLoopVideos();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
