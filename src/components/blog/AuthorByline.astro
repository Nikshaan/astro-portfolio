---
interface Props {
  avatarSrc: string;
}

const { avatarSrc } = Astro.props;
---

<div class="author-byline" data-pagefind-ignore>
  <div class="author-byline__person">
    <img
      class="author-byline__avatar"
      src={avatarSrc}
      alt=""
      width="44"
      height="44"
      decoding="async"
    />
    <div class="author-byline__who">
      <p class="author-byline__name">Written by Nikshaan</p>
      <p class="author-byline__place">Mumbai, India</p>
    </div>
  </div>

  <div class="author-byline__links">
    <a
      href="https://www.linkedin.com/in/nikshaan-shetty/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect x="2" y="9" width="4" height="12"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
    </a>
    <a
      href="https://github.com/Nikshaan"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
      </svg>
    </a>
    <a href="mailto:nikshaanshetty06@gmail.com" aria-label="Gmail">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <polyline points="3 7 12 13 21 7"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .author-byline {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .author-byline__person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .author-byline__avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--border-strong);
    flex-shrink: 0;
  }

  .author-byline__who {
    min-width: 0;
  }

  .author-byline__name,
  .author-byline__place {
    margin: 0;
  }

  .author-byline__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .author-byline__place {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .author-byline__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .author-byline__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-control);
    transition: color 0.15s ease;
  }

  .author-byline__links a:hover {
    color: var(--accent);
  }

  .author-byline__links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .author-byline__links svg {
    width: 1.05rem;
    height: 1.05rem;
  }
</style>
