flowchart TD
    INPUT["Voice or text"]
    STT["Speech-to-text<br/>and editable transcript"]
    APP["CLI or React UI with FastAPI"]
    AGENT["Router LLM in LangGraph"]
    READ["Read tools"]
    PROPOSE["Write tools<br/>propose only"]
    PAUSE["Checkpoint and<br/>wait for approval"]
    COMMIT["Commit step"]
    DB[("Your SQLite database")]
    SIDE[("Sidecar folder<br/>manifest, history, undo log, checkpoints")]

    INPUT --> STT --> APP --> AGENT
    AGENT --> READ --> DB
    READ --> AGENT
    AGENT --> PROPOSE --> PAUSE --> COMMIT --> DB
    AGENT -.-> SIDE
    COMMIT -.-> SIDE
