---
interface Props {
    title: string;
    description: string;
    canonicalUrl?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
    ogType?: string;
    publishedTime?: string;
    modifiedTime?: string;
    preloadImageSrc?: string;
    preloadImageSrcSet?: string;
    preloadImageSizes?: string;
    noindex?: boolean;
    preloadMonoFont?: boolean;
}

import beeImage from "../data/bee.avif";
import { getImage } from "astro:assets";
import VercelAnalytics from "../components/VercelAnalytics.astro";
import Footer from "../components/Footer";
import "../styles/global.css";
import spaceGroteskWoff2 from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import interWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import jetbrainsMonoWoff2 from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

const {
    title,
    description,
    canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://nikshaan.dev").href,
    ogImage,
    ogImageAlt = "Nikshaan",
    ogImageWidth = 1200,
    ogImageHeight = 630,
    ogType = "website",
    publishedTime,
    modifiedTime,
    preloadImageSrc,
    preloadImageSrcSet,
    preloadImageSizes,
    noindex = false,
    preloadMonoFont = false,
} = Astro.props;

const toJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");

const favicon = await getImage({
    src: beeImage,
    format: "png",
    width: 32,
    height: 32,
});

const appleTouchIcon = await getImage({
    src: beeImage,
    format: "png",
    width: 180,
    height: 180,
});

const resolvedOgImage = ogImage
    ? new URL(ogImage, Astro.site || "https://nikshaan.dev").href
    : "https://nikshaan.dev/linkedin_banner.png";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href={favicon.src} />
        <link rel="manifest" href="/manifest.json" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta content={description} name="description" />
        <meta content="Nikshaan Shetty" name="author" />
        <meta content={noindex ? "noindex, follow" : "index, follow"} name="robots" />
        {!noindex && <link rel="canonical" href={canonicalUrl} />}
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Nikshaan Shetty's Blog"
            href={new URL("rss.xml", Astro.site || "https://nikshaan.dev")}
        />

        <meta content={title} property="og:title" />
        <meta content={description} property="og:description" />
        <meta content={ogType} property="og:type" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content={resolvedOgImage} property="og:image" />
        <meta content={resolvedOgImage} property="og:image:secure_url" />
        <meta content={String(ogImageWidth)} property="og:image:width" />
        <meta content={String(ogImageHeight)} property="og:image:height" />
        <meta content={ogImageAlt} property="og:image:alt" />
        <meta content={resolvedOgImage.endsWith(".webp") ? "image/webp" : resolvedOgImage.endsWith(".png") ? "image/png" : "image/jpeg"} property="og:image:type" />
        <meta content="en_IN" property="og:locale" />
        <meta content="Nikshaan Shetty" property="og:site_name" />

        {publishedTime && <meta content={publishedTime} property="article:published_time" />}
        {modifiedTime && <meta content={modifiedTime} property="article:modified_time" />}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={resolvedOgImage}
        />
        <meta name="twitter:image:alt" content={ogImageAlt} />

        <meta name="theme-color" content="#0a0a0a" id="meta-theme-color" />
        <meta name="color-scheme" content="dark light" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
        />
        <meta name="apple-mobile-web-app-title" content="Nikshaan" />
        <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />

        <link rel="preload" as="font" type="font/woff2" href={spaceGroteskWoff2} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
        {preloadMonoFont && <link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoWoff2} crossorigin />}
        <slot name="head" />

        {
            preloadImageSrc && (
                <link
                    rel="preload"
                    as="image"
                    href={preloadImageSrc}
                    imagesrcset={preloadImageSrcSet}
                    imagesizes={preloadImageSizes}
                    fetchpriority="high"
                    type="image/avif"
                />
            )
        }

        <script type="speculationrules" is:inline>
            {
                "prerender": [
                    {
                        "where": {
                            "and": [
                                { "href_matches": "/*" },
                                { "not": { "href_matches": "/api/*" } },
                                { "not": { "href_matches": "/rss.xml" } }
                            ]
                        },
                        "eagerness": "moderate"
                    }
                ],
                "prefetch": [
                    {
                        "where": {
                            "and": [
                                { "href_matches": "/*" },
                                { "not": { "href_matches": "/api/*" } },
                                { "not": { "href_matches": "/rss.xml" } }
                            ]
                        },
                        "eagerness": "moderate"
                    }
                ]
            }
        </script>

        <script is:inline>
            (function () {
                var root = document.documentElement;
                root.classList.add("bento-reveal-js");

                function pathOf(url) {
                    if (!url) return "";
                    try {
                        var parsed = new URL(url, location.href);
                        if (parsed.origin !== location.origin) return "";
                        return parsed.pathname.replace(/\/+$/, "") || "/";
                    } catch (e) {
                        return "";
                    }
                }

                function isPost(path) {
                    return /^\/blog\/[^/]+$/.test(path) && path !== "/blog/tags";
                }

                function currentState() {
                    var state = history.state;
                    return state && typeof state === "object" ? Object.assign({}, state) : {};
                }

                function scrollAnchor() {
                    var best = null;
                    var bestTop = -Infinity;
                    var nodes = document.querySelectorAll("main [id]");
                    for (var i = 0; i < nodes.length; i++) {
                        var node = nodes[i];
                        if (node.closest("[role='dialog']")) continue;
                        var rect = node.getBoundingClientRect();
                        if (!rect.height || rect.top > 1 || rect.top <= bestTop) continue;
                        best = node;
                        bestTop = rect.top;
                    }
                    return best ? { id: best.id, offset: Math.round(-bestTop) } : null;
                }

                function targetFor(saved) {
                    var node = saved.anchor && document.getElementById(saved.anchor);
                    if (!node) return saved.scrollY;
                    return Math.max(0, Math.round(node.getBoundingClientRect().top + window.scrollY + saved.anchorOffset));
                }

                function pin(computeTarget, holdMs) {
                    var stopped = false;
                    var observer = null;
                    var inputs = ["wheel", "touchstart", "keydown", "pointerdown"];
                    var apply = function () {
                        if (stopped) return;
                        var target = computeTarget();
                        if (Number.isFinite(target) && Math.abs(window.scrollY - target) > 1) window.scrollTo(0, target);
                    };
                    var stop = function () {
                        if (stopped) return;
                        stopped = true;
                        if (observer) observer.disconnect();
                        for (var i = 0; i < inputs.length; i++) window.removeEventListener(inputs[i], stop, true);
                    };
                    for (var i = 0; i < inputs.length; i++) {
                        window.addEventListener(inputs[i], stop, { capture: true, passive: true });
                    }
                    if ("ResizeObserver" in window) {
                        observer = new ResizeObserver(apply);
                        observer.observe(root);
                        var observeBody = function () { if (document.body) observer.observe(document.body); };
                        if (document.body) observeBody();
                        else document.addEventListener("DOMContentLoaded", observeBody, { once: true });
                    }
                    var stopLater = function () { setTimeout(stop, holdMs); };
                    if (document.readyState === "complete") stopLater();
                    else window.addEventListener("load", stopLater, { once: true });
                    return apply;
                }

                function saveState() {
                    try {
                        var anchor = scrollAnchor();
                        var dialog = document.querySelector("[data-history-modal]");
                        var scroller = dialog && dialog.querySelector("[data-modal-scroll]");
                        var search = document.getElementById("blog-search-input");
                        var state = currentState();
                        state.pageState = Object.assign({}, state.pageState, {
                            scrollY: Math.round(window.scrollY),
                            anchor: anchor ? anchor.id : null,
                            anchorOffset: anchor ? anchor.offset : 0,
                            modal: dialog ? dialog.getAttribute("data-history-modal") : null,
                            modalScroll: scroller ? Math.round(scroller.scrollTop) : 0,
                            search: search ? search.value : "",
                        });
                        history.replaceState(state, "");
                    } catch (e) {}
                }

                function leaveHint() {
                    var here = pathOf(location.href);
                    var stamp = history.state && history.state.blogBack;
                    var from = isPost(here) && stamp ? stamp.from : here;
                    var depth = isPost(here) && stamp ? stamp.depth + 1 : 1;
                    try {
                        sessionStorage.setItem("portfolio_blog_from", from);
                        sessionStorage.setItem("portfolio_blog_depth", String(depth));
                    } catch (e) {}
                }

                function linkTarget(event) {
                    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return "";
                    var link = event.target && event.target.closest ? event.target.closest("a[href]") : null;
                    if (!link || link.hasAttribute("download")) return "";
                    if (link.target && link.target !== "_self") return "";
                    var url = new URL(link.href, location.href);
                    if (url.origin !== location.origin) return "";
                    if (url.pathname === location.pathname && url.search === location.search) return "";
                    return pathOf(url.href);
                }

                function onLeaveIntent(event) {
                    var target = linkTarget(event);
                    if (!target) return;
                    if (event.type === "click") saveState();
                    if (isPost(target)) leaveHint();
                }

                document.addEventListener("pointerdown", onLeaveIntent, true);
                document.addEventListener("click", onLeaveIntent, true);
                window.addEventListener("pagehide", saveState);

                window.addEventListener("pageshow", function (event) {
                    var saved = event.persisted && history.state && history.state.pageState;
                    if (saved && saved.scrollY > 0) pin(function () { return targetFor(saved); }, 1200)();
                });

                window.portfolioNav = {
                    pin: pin,
                    pathOf: pathOf,
                    isPost: isPost,
                    returnTo: function (from, depth) {
                        if (!from) return false;
                        try {
                            if (window.navigation && navigation.currentEntry && navigation.entries) {
                                var entries = navigation.entries();
                                for (var i = navigation.currentEntry.index - 1; i >= 0; i--) {
                                    if (pathOf(entries[i].url) === from) {
                                        navigation.traverseTo(entries[i].key);
                                        return true;
                                    }
                                }
                                return false;
                            }
                        } catch (e) {}
                        if (depth >= 1 && history.length > depth) {
                            history.go(-depth);
                            return true;
                        }
                        return false;
                    },
                };

                try {
                    var navEntry = performance.getEntriesByType("navigation")[0];
                    if (!navEntry || navEntry.type !== "back_forward") return;
                    root.classList.add("bento-reveal-settled");
                    var saved = history.state && history.state.pageState;
                    if (!saved || !(saved.scrollY > 0)) return;

                    root.classList.add("restore-pending");
                    root.style.scrollBehavior = "auto";
                    var hold = pin(function () { return targetFor(saved); }, 1500);
                    var attempts = 0;
                    var lastHeight = -1;
                    var stableFrames = 0;
                    var tick = function () {
                        hold();
                        var target = targetFor(saved);
                        var height = root.scrollHeight;
                        stableFrames = height === lastHeight ? stableFrames + 1 : 0;
                        lastHeight = height;
                        attempts += 1;
                        var atTarget = Math.abs(window.scrollY - target) <= 1;
                        var loaded = document.readyState === "complete";
                        if ((atTarget && stableFrames >= 2 && (loaded || attempts > 8)) || attempts > 90) {
                            root.classList.remove("restore-pending");
                            root.style.scrollBehavior = "";
                            return;
                        }
                        requestAnimationFrame(tick);
                    };
                    requestAnimationFrame(tick);
                } catch (e) {}
            })();
        </script>

        <script is:inline>
            (function () {
                function applyStoredTheme(sync) {
                    try {
                        var root = document.documentElement;
                        var stored = localStorage.getItem("theme");
                        var isLight =
                            stored === "light" ||
                            (stored === null &&
                                window.matchMedia &&
                                window.matchMedia("(prefers-color-scheme: light)")
                                    .matches);
                        if (sync && isLight === (root.getAttribute("data-theme") === "light")) {
                            return;
                        }
                        if (sync) root.classList.add("theme-sync");
                        var meta = document.getElementById("meta-theme-color");
                        if (isLight) {
                            root.setAttribute("data-theme", "light");
                            if (meta) meta.setAttribute("content", "#efeef3");
                        } else {
                            root.removeAttribute("data-theme");
                            if (sync && meta) meta.setAttribute("content", "#0a0a0a");
                        }
                        if (sync) {
                            void root.offsetHeight;
                            requestAnimationFrame(function () {
                                root.classList.remove("theme-sync");
                            });
                        }
                    } catch (e) {}
                }

                applyStoredTheme(false);
                document.addEventListener("prerenderingchange", function () {
                    applyStoredTheme(true);
                });
                window.addEventListener("pageshow", function (event) {
                    if (event.persisted) applyStoredTheme(true);
                });

                if (
                    "connection" in navigator &&
                    navigator.connection.saveData
                ) {
                    document.documentElement.classList.add("save-data");
                }

                function handleChunkError() {
                    const reloadKey = "chunk_err_reload";
                    const lastReload = sessionStorage.getItem(reloadKey);
                    if (
                        !lastReload ||
                        Date.now() - parseInt(lastReload) > 10000
                    ) {
                        sessionStorage.setItem(
                            reloadKey,
                            Date.now().toString(),
                        );
                        window.location.reload();
                    }
                }

                window.addEventListener("vite:preloadError", handleChunkError);

                window.addEventListener("unhandledrejection", function (e) {
                    if (
                        e.reason &&
                        e.reason.message &&
                        e.reason.message.includes(
                            "Failed to fetch dynamically imported module",
                        )
                    ) {
                        e.preventDefault();
                        handleChunkError();
                    }
                });

                window.addEventListener("astro:hydration-error", function (e) {
                    if (
                        e.detail &&
                        e.detail.error &&
                        e.detail.error.message &&
                        e.detail.error.message.includes(
                            "Failed to fetch dynamically imported module",
                        )
                    ) {
                        e.preventDefault();
                        handleChunkError();
                    }
                });
            })();
        </script>
    </head>
    <body class="h-full">
        <script is:inline>
            (function () {
                var docEl = document.documentElement;
                if (!docEl.classList.contains("bento-reveal-js")) return;
                if (
                    window.matchMedia &&
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ) {
                    return;
                }

                var EASE =
                    "opacity 0.4s cubic-bezier(0.25, 0.1, 0.25, 1), transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1)";
                var playing = typeof WeakSet === "function" ? new WeakSet() : null;
                var frozen = typeof WeakSet === "function" ? new WeakSet() : null;
                var eagerQueued = typeof WeakSet === "function" ? new WeakSet() : null;

                function isFrozen(el) {
                    if (frozen && frozen.has(el)) return true;
                    return (
                        el.style.getPropertyValue("opacity") === "1" &&
                        el.style.getPropertyValue("transform") === "translateY(0)" &&
                        !el.style.getPropertyValue("transition")
                    );
                }

                function freeze(el) {
                    if (frozen) frozen.add(el);
                    el.style.setProperty("opacity", "1");
                    el.style.setProperty("transform", "translateY(0)");
                    el.style.setProperty("animation", "none");
                    el.style.removeProperty("transition");
                    if (playing) playing.delete(el);
                }

                function play(el) {
                    if (isFrozen(el)) return;
                    if (playing && playing.has(el)) return;
                    if (playing) playing.add(el);
                    el.style.setProperty("animation", "none");
                    el.style.setProperty("transition", "none");
                    el.style.setProperty("opacity", "0");
                    el.style.setProperty("transform", "translateY(16px)");
                    void el.offsetWidth;
                    el.style.setProperty("transition", EASE);
                    el.style.setProperty("opacity", "1");
                    el.style.setProperty("transform", "translateY(0)");
                    window.setTimeout(function () {
                        freeze(el);
                    }, 450);
                }

                function trackEager(el) {
                    if (isFrozen(el)) return;
                    if (eagerQueued && eagerQueued.has(el)) return;
                    if (eagerQueued) eagerQueued.add(el);
                    window.setTimeout(function () {
                        freeze(el);
                    }, 450);
                }

                if (!("IntersectionObserver" in window)) {
                    var fallback = document.querySelectorAll(".bento-reveal");
                    for (var f = 0; f < fallback.length; f++) play(fallback[f]);
                    return;
                }

                var io = new IntersectionObserver(
                    function (entries) {
                        for (var i = 0; i < entries.length; i++) {
                            var entry = entries[i];
                            if (!entry.isIntersecting) continue;
                            io.unobserve(entry.target);
                            play(entry.target);
                        }
                    },
                    { threshold: 0, rootMargin: "0px" },
                );

                var earlyIo = new IntersectionObserver(
                    function (entries) {
                        for (var i = 0; i < entries.length; i++) {
                            var entry = entries[i];
                            if (!entry.isIntersecting) continue;
                            earlyIo.unobserve(entry.target);
                            play(entry.target);
                        }
                    },
                    { threshold: 0, rootMargin: "0px" },
                );

                var leadIo = new IntersectionObserver(
                    function (entries) {
                        for (var i = 0; i < entries.length; i++) {
                            var entry = entries[i];
                            if (!entry.isIntersecting) continue;
                            leadIo.unobserve(entry.target);
                            play(entry.target);
                        }
                    },
                    { threshold: 0, rootMargin: "0px 0px 128px 0px" },
                );

                function observe(el) {
                    if (!el || el.nodeType !== 1 || !el.classList) return;
                    if (!el.classList.contains("bento-reveal")) return;
                    if (docEl.classList.contains("bento-reveal-settled")) {
                        freeze(el);
                        return;
                    }
                    if (frozen && frozen.has(el)) {
                        freeze(el);
                        return;
                    }
                    if (isFrozen(el)) return;
                    if (el.classList.contains("bento-reveal-eager")) {
                        trackEager(el);
                        return;
                    }
                    if (playing && playing.has(el)) return;
                    if (el.classList.contains("bento-reveal-early")) {
                        earlyIo.observe(el);
                        return;
                    }
                    if (el.classList.contains("bento-reveal-lead")) {
                        leadIo.observe(el);
                        return;
                    }
                    io.observe(el);
                }

                function scan(root) {
                    if (!root || root.nodeType !== 1) return;
                    observe(root);
                    var nodes = root.querySelectorAll(".bento-reveal");
                    for (var i = 0; i < nodes.length; i++) observe(nodes[i]);
                }

                scan(docEl);

                var mo = new MutationObserver(function (mutations) {
                    for (var i = 0; i < mutations.length; i++) {
                        var mutation = mutations[i];
                        if (mutation.type === "attributes") {
                            observe(mutation.target);
                            continue;
                        }
                        var added = mutation.addedNodes;
                        for (var j = 0; j < added.length; j++) scan(added[j]);
                    }
                });
                mo.observe(docEl, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ["class"],
                });
            })();
        </script>
        <slot />
        <Footer
            client:visible={{ rootMargin: "480px" }}
            revealEarly={Astro.url.pathname.startsWith("/blog")}
        />
        <VercelAnalytics />
        <script
            type="application/ld+json"
            is:inline
            set:html={toJsonLd({
                "@context": "https://schema.org",
                "@type": "Person",
                "@id": "https://nikshaan.dev/#person",
                name: "Nikshaan Shetty",
                url: "https://nikshaan.dev",
                image: "https://nikshaan.dev/linkedin_banner.webp",
                sameAs: [
                    "https://www.linkedin.com/in/nikshaan-shetty/",
                    "https://github.com/Nikshaan",
                ],
                jobTitle: "Applied AI and Software Developer",
                worksFor: {
                    "@type": "Organization",
                    name: "Mentoria",
                },
                alumniOf: {
                    "@type": "CollegeOrUniversity",
                    name: "Dwarkadas J. Sanghvi College of Engineering",
                    address: {
                        "@type": "PostalAddress",
                        addressLocality: "Mumbai",
                        addressCountry: "IN",
                    },
                },
                knowsAbout: [
                    "Artificial Intelligence",
                    "Machine Learning",
                    "React",
                    "Python",
                    "LLM",
                    "FastAPI",
                ],
            })}
        />
    </body>
</html>

<style>
    body {
        overflow-x: hidden;
        overflow-x: clip;
        margin: 0;
        padding: 0;
    }
</style>
