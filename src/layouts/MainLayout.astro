---
interface Props {
    title: string;
    description: string;
    preloadImageSrc?: string;
    preloadImageSrcSet?: string;
    preloadImageSizes?: string;
}

import beeImage from "../data/bee.avif";
import { getImage } from "astro:assets";
import VercelAnalytics from "../components/VercelAnalytics.astro";
import Footer from "../components/Footer";
import "../styles/global.css";
import iaWriterQuattroWoff2 from "@fontsource/ia-writer-quattro/files/ia-writer-quattro-latin-400-normal.woff2?url";
import ibmPlexSerifWoff2 from "@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-700-normal.woff2?url";

const { title, description, preloadImageSrc, preloadImageSrcSet, preloadImageSizes } = Astro.props;

const favicon = await getImage({
    src: beeImage,
    format: "png",
    width: 32,
    height: 32,
});

const appleTouchIcon = await getImage({
    src: beeImage,
    format: "png",
    width: 180,
    height: 180,
});

const ogImageUrl = "https://nikshaan.dev/linkedin_banner.webp";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href={favicon.src} />
        <link rel="manifest" href="/manifest.json" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta content={description} name="description" />
        <meta content="Nikshaan Shetty" name="author" />
        <meta content="index, follow" name="robots" />
        <link rel="canonical" href="https://nikshaan.dev/" />

        <meta content={title} property="og:title" />
        <meta content={description} property="og:description" />
        <meta content="website" property="og:type" />
        <meta content="https://nikshaan.dev/" property="og:url" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content={ogImageUrl} property="og:image:secure_url" />
        <meta content="1200" property="og:image:width" />
        <meta content="630" property="og:image:height" />
        <meta content="Nikshaan" property="og:image:alt" />
        <meta content="image/webp" property="og:image:type" />
        <meta content="en_IN" property="og:locale" />
        <meta content="Nikshaan Shetty Portfolio" property="og:site_name" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={ogImageUrl}
        />

        <meta name="theme-color" content="#0a0a0a" id="meta-theme-color" />
        <meta name="color-scheme" content="dark light" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
        />
        <meta name="apple-mobile-web-app-title" content="Nikshaan" />
        <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />

        <link rel="preload" as="font" type="font/woff2" href={iaWriterQuattroWoff2} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={ibmPlexSerifWoff2} crossorigin />

        {
            preloadImageSrc && (
                <link
                    rel="preload"
                    as="image"
                    href={preloadImageSrc}
                    imagesrcset={preloadImageSrcSet}
                    imagesizes={preloadImageSizes}
                    fetchpriority="high"
                    type="image/avif"
                />
            )
        }

        <script type="speculationrules" is:inline>
            {
                "prefetch": [
                    {
                        "urls": ["https://nikshaan.dev/"],
                        "eagerness": "moderate"
                    }
                ]
            }
        </script>

        <script is:inline>
            (function () {
                document.documentElement.classList.add("bento-reveal-js");

                try {
                    var stored = localStorage.getItem("theme");
                    var isLight =
                        stored === "light" ||
                        (stored === null &&
                            window.matchMedia &&
                            window.matchMedia("(prefers-color-scheme: light)")
                                .matches);
                    if (isLight) {
                        document.documentElement.setAttribute(
                            "data-theme",
                            "light",
                        );
                        var meta = document.getElementById("meta-theme-color");
                        if (meta) meta.setAttribute("content", "#efeef3");
                    } else {
                        document.documentElement.removeAttribute("data-theme");
                    }
                } catch (e) {}

                if (
                    "connection" in navigator &&
                    navigator.connection.saveData
                ) {
                    document.documentElement.classList.add("save-data");
                }

                function handleChunkError() {
                    const reloadKey = "chunk_err_reload";
                    const lastReload = sessionStorage.getItem(reloadKey);
                    if (
                        !lastReload ||
                        Date.now() - parseInt(lastReload) > 10000
                    ) {
                        sessionStorage.setItem(
                            reloadKey,
                            Date.now().toString(),
                        );
                        window.location.reload();
                    }
                }

                window.addEventListener("vite:preloadError", handleChunkError);

                window.addEventListener("unhandledrejection", function (e) {
                    if (
                        e.reason &&
                        e.reason.message &&
                        e.reason.message.includes(
                            "Failed to fetch dynamically imported module",
                        )
                    ) {
                        e.preventDefault();
                        handleChunkError();
                    }
                });

                window.addEventListener("astro:hydration-error", function (e) {
                    if (
                        e.detail &&
                        e.detail.error &&
                        e.detail.error.message &&
                        e.detail.error.message.includes(
                            "Failed to fetch dynamically imported module",
                        )
                    ) {
                        e.preventDefault();
                        handleChunkError();
                    }
                });
            })();
        </script>
    </head>
    <body class="h-full">
        <script is:inline>
            (function () {
                var docEl = document.documentElement;
                if (!docEl.classList.contains("bento-reveal-js")) return;
                if (
                    window.matchMedia &&
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ) {
                    return;
                }

                var EASE =
                    "opacity 0.4s cubic-bezier(0.25, 0.1, 0.25, 1), transform 0.4s cubic-bezier(0.25, 0.1, 0.25, 1)";
                var playing = typeof WeakSet === "function" ? new WeakSet() : null;
                var frozen = typeof WeakSet === "function" ? new WeakSet() : null;
                var eagerQueued = typeof WeakSet === "function" ? new WeakSet() : null;

                function isFrozen(el) {
                    if (frozen && frozen.has(el)) return true;
                    return (
                        el.style.getPropertyValue("opacity") === "1" &&
                        el.style.getPropertyValue("transform") === "translateY(0)" &&
                        !el.style.getPropertyValue("transition")
                    );
                }

                function freeze(el) {
                    if (frozen) frozen.add(el);
                    el.style.setProperty("opacity", "1");
                    el.style.setProperty("transform", "translateY(0)");
                    el.style.setProperty("animation", "none");
                    el.style.removeProperty("transition");
                    if (playing) playing.delete(el);
                }

                function play(el) {
                    if (isFrozen(el)) return;
                    if (playing && playing.has(el)) return;
                    if (playing) playing.add(el);
                    el.style.setProperty("animation", "none");
                    el.style.setProperty("transition", "none");
                    el.style.setProperty("opacity", "0");
                    el.style.setProperty("transform", "translateY(16px)");
                    void el.offsetWidth;
                    el.style.setProperty("transition", EASE);
                    el.style.setProperty("opacity", "1");
                    el.style.setProperty("transform", "translateY(0)");
                    window.setTimeout(function () {
                        freeze(el);
                    }, 450);
                }

                function trackEager(el) {
                    if (isFrozen(el)) return;
                    if (eagerQueued && eagerQueued.has(el)) return;
                    if (eagerQueued) eagerQueued.add(el);
                    window.setTimeout(function () {
                        freeze(el);
                    }, 450);
                }

                if (!("IntersectionObserver" in window)) {
                    var fallback = document.querySelectorAll(".bento-reveal");
                    for (var f = 0; f < fallback.length; f++) play(fallback[f]);
                    return;
                }

                var io = new IntersectionObserver(
                    function (entries) {
                        for (var i = 0; i < entries.length; i++) {
                            var entry = entries[i];
                            if (!entry.isIntersecting) continue;
                            io.unobserve(entry.target);
                            play(entry.target);
                        }
                    },
                    { threshold: 0.2, rootMargin: "80px 0px -10% 0px" },
                );

                function observe(el) {
                    if (!el || el.nodeType !== 1 || !el.classList) return;
                    if (!el.classList.contains("bento-reveal")) return;
                    if (frozen && frozen.has(el)) {
                        freeze(el);
                        return;
                    }
                    if (isFrozen(el)) return;
                    if (el.classList.contains("bento-reveal-eager")) {
                        trackEager(el);
                        return;
                    }
                    if (playing && playing.has(el)) return;
                    io.observe(el);
                }

                function scan(root) {
                    if (!root || root.nodeType !== 1) return;
                    observe(root);
                    var nodes = root.querySelectorAll(".bento-reveal");
                    for (var i = 0; i < nodes.length; i++) observe(nodes[i]);
                }

                scan(docEl);

                var mo = new MutationObserver(function (mutations) {
                    for (var i = 0; i < mutations.length; i++) {
                        var mutation = mutations[i];
                        if (mutation.type === "attributes") {
                            observe(mutation.target);
                            continue;
                        }
                        var added = mutation.addedNodes;
                        for (var j = 0; j < added.length; j++) scan(added[j]);
                    }
                });
                mo.observe(docEl, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ["class"],
                });
            })();
        </script>
        <slot />
        <Footer client:visible />
        <VercelAnalytics />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Nikshaan Shetty",
                url: "https://nikshaan.dev",
                image: "https://nikshaan.dev/linkedin_banner.webp",
                sameAs: [
                    "https://www.linkedin.com/in/nikshaan-shetty/",
                    "https://github.com/Nikshaan",
                ],
                jobTitle: "AI/ML Student & Software Developer",
                worksFor: {
                    "@type": "Organization",
                    name: "Mentoria",
                },
                alumniOf: {
                    "@type": "CollegeOrUniversity",
                    name: "Dwarkadas J. Sanghvi College of Engineering",
                    address: {
                        "@type": "PostalAddress",
                        addressLocality: "Mumbai",
                        addressCountry: "IN",
                    },
                },
                knowsAbout: [
                    "Artificial Intelligence",
                    "Machine Learning",
                    "React",
                    "Python",
                    "LLM",
                    "FastAPI",
                ],
            })}
        />
    </body>
</html>

<style>
    body {
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }
</style>
