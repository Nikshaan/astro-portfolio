---
interface Props {
    title: string;
    description: string;
    preloadImageSrc?: string;
    preloadImageSrcSet?: string;
    preloadImageSizes?: string;
}

import beeImage from "../data/bee.avif";
import { getImage } from "astro:assets";
import VercelAnalytics from "../components/VercelAnalytics.astro";
import Footer from "../components/Footer";
import "../styles/global.css";
import dmSansWoff2 from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import spaceGroteskWoff2 from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";

const { title, description, preloadImageSrc, preloadImageSrcSet, preloadImageSizes } = Astro.props;

const favicon = await getImage({
    src: beeImage,
    format: "png",
    width: 32,
    height: 32,
});

const appleTouchIcon = await getImage({
    src: beeImage,
    format: "png",
    width: 180,
    height: 180,
});

const ogImageUrl = "https://nikshaan.dev/linkedin_banner.webp";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href={favicon.src} />
        <link rel="manifest" href="/manifest.json" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta content={description} name="description" />
        <meta content="Nikshaan Shetty" name="author" />
        <meta content="index, follow" name="robots" />
        <link rel="canonical" href="https://nikshaan.dev/" />

        <meta content={title} property="og:title" />
        <meta content={description} property="og:description" />
        <meta content="website" property="og:type" />
        <meta content="https://nikshaan.dev/" property="og:url" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content={ogImageUrl} property="og:image:secure_url" />
        <meta content="1200" property="og:image:width" />
        <meta content="630" property="og:image:height" />
        <meta content="Nikshaan" property="og:image:alt" />
        <meta content="image/webp" property="og:image:type" />
        <meta content="en_IN" property="og:locale" />
        <meta content="Nikshaan Shetty Portfolio" property="og:site_name" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={ogImageUrl}
        />

        <meta name="theme-color" content="#0a0a0a" id="meta-theme-color" />
        <meta name="color-scheme" content="dark light" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
        />
        <meta name="apple-mobile-web-app-title" content="Nikshaan" />
        <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />

        <link rel="preload" as="font" type="font/woff2" href={dmSansWoff2} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={spaceGroteskWoff2} crossorigin />

        <link rel="preconnect" href="https://i.scdn.co" crossorigin />

        {
            preloadImageSrc && (
                <link
                    rel="preload"
                    as="image"
                    href={preloadImageSrc}
                    imagesrcset={preloadImageSrcSet}
                    imagesizes={preloadImageSizes}
                    fetchpriority="high"
                    type="image/avif"
                />
            )
        }

        <script type="speculationrules" is:inline>
            {
                "prefetch": [
                    {
                        "urls": ["https://nikshaan.dev/"],
                        "eagerness": "moderate"
                    }
                ]
            }
        </script>

        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem("theme");
                    var isLight =
                        stored === "light" ||
                        (stored === null &&
                            window.matchMedia &&
                            window.matchMedia("(prefers-color-scheme: light)")
                                .matches);
                    if (isLight) {
                        document.documentElement.setAttribute(
                            "data-theme",
                            "light",
                        );
                        var meta = document.getElementById("meta-theme-color");
                        if (meta) meta.setAttribute("content", "#efeef3");
                    } else {
                        document.documentElement.removeAttribute("data-theme");
                    }
                } catch (e) {}

                if (
                    "connection" in navigator &&
                    navigator.connection.saveData
                ) {
                    document.documentElement.classList.add("save-data");
                }

                window.addEventListener("vite:preloadError", function () {
                    const reloadKey = "vite_chunk_err_reload";
                    const lastReload = sessionStorage.getItem(reloadKey);
                    if (
                        !lastReload ||
                        Date.now() - parseInt(lastReload) > 10000
                    ) {
                        sessionStorage.setItem(
                            reloadKey,
                            Date.now().toString(),
                        );
                        window.location.reload();
                    }
                });

                window.addEventListener("unhandledrejection", function (e) {
                    if (
                        e.reason &&
                        e.reason.message &&
                        e.reason.message.includes(
                            "Failed to fetch dynamically imported module",
                        )
                    ) {
                        e.preventDefault();
                        const reloadKey = "import_chunk_err_reload";
                        const lastReload = sessionStorage.getItem(reloadKey);
                        if (
                            !lastReload ||
                            Date.now() - parseInt(lastReload) > 10000
                        ) {
                            sessionStorage.setItem(
                                reloadKey,
                                Date.now().toString(),
                            );
                            window.location.reload();
                        }
                    }
                });
            })();
        </script>
    </head>
    <body class="h-full">
        <slot />
        <Footer client:visible />
        <VercelAnalytics />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Nikshaan Shetty",
                url: "https://nikshaan.dev",
                image: "https://nikshaan.dev/linkedin_banner.webp",
                sameAs: [
                    "https://www.linkedin.com/in/nikshaan-shetty/",
                    "https://github.com/Nikshaan",
                ],
                jobTitle: "AI/ML Student & Software Developer",
                worksFor: {
                    "@type": "Organization",
                    name: "Mentoria",
                },
                alumniOf: {
                    "@type": "CollegeOrUniversity",
                    name: "Dwarkadas J. Sanghvi College of Engineering",
                    address: {
                        "@type": "PostalAddress",
                        addressLocality: "Mumbai",
                        addressCountry: "IN",
                    },
                },
                knowsAbout: [
                    "Artificial Intelligence",
                    "Machine Learning",
                    "React",
                    "Python",
                    "LLM",
                    "FastAPI",
                ],
            })}
        />
    </body>
</html>

<style>
    body {
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }
</style>
