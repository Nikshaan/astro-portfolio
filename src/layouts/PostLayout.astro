---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import MainLayout from "./MainLayout.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import PostTags from "../components/blog/PostTags.astro";
import AuthorByline from "../components/blog/AuthorByline.astro";
import ShareButton from "../components/blog/ShareButton.astro";
import CodeCopy from "../components/blog/CodeCopy.astro";
import NavbarWrapper from "../components/NavbarWrapper.astro";
import LlmBanner from "../components/blog/LlmBanner.astro";
import { getReadingTime } from "../utils/readingTime";
import { BLOG_ARCHIVE_ENABLED } from "../lib/blogArchive";
import { getImage } from "astro:assets";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import beeImage from "../data/bee.avif";

interface Props {
  post: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const readingStats = getReadingTime(post.body || "");
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
const authorAvatar = await getImage({
  src: beeImage,
  format: "avif",
  width: 88,
  height: 88,
  quality: 80,
});

const canonicalUrl = post.data.canonicalURL || new URL(`/blog/${post.id}/`, Astro.site || "https://nikshaan.dev").href;
const ogImagePath = post.data.ogImage || "https://nikshaan.dev/linkedin_banner.png";
const ogImage = ogImagePath.startsWith("http")
  ? ogImagePath
  : new URL(ogImagePath, Astro.site || "https://nikshaan.dev").href;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(post.data.pubDate);

const formattedUpdatedDate = post.data.updatedDate
  ? new Intl.DateTimeFormat("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }).format(post.data.updatedDate)
  : null;

const siteUrl = new URL("/", Astro.site || "https://nikshaan.dev").href;
const ogImageAlt = post.data.ogImageAlt || post.data.title;

function localPngSize(path: string) {
  if (path.startsWith("http") || !path.endsWith(".png")) return null;
  try {
    const header = readFileSync(join(process.cwd(), "public", path)).subarray(0, 24);
    if (header.toString("ascii", 12, 16) !== "IHDR") return null;
    return { width: header.readUInt32BE(16), height: header.readUInt32BE(20) };
  } catch {
    return null;
  }
}

const ogImageSize = localPngSize(ogImagePath) ?? { width: 1200, height: 630 };

const author = {
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name: "Nikshaan Shetty",
  url: siteUrl,
  jobTitle: "Applied AI and Software Developer",
  sameAs: [
    "https://www.linkedin.com/in/nikshaan-shetty/",
    "https://github.com/Nikshaan",
  ],
};

const breadcrumbTrail = [
  { name: "Home", url: siteUrl },
  ...(BLOG_ARCHIVE_ENABLED ? [{ name: "Blog", url: new URL("/blog/", siteUrl).href }] : []),
  { name: post.data.title, url: canonicalUrl },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
      author,
      publisher: author,
      url: canonicalUrl,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
      image: {
        "@type": "ImageObject",
        url: ogImage,
        width: ogImageSize.width,
        height: ogImageSize.height,
        caption: ogImageAlt,
      },
      inLanguage: "en-IN",
      wordCount: readingStats.words,
      articleSection: post.data.tags[0],
      keywords: post.data.tags.join(", "),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbTrail.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    },
  ],
};
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogImageWidth={ogImageSize.width}
  ogImageHeight={ogImageSize.height}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate ? post.data.updatedDate.toISOString() : undefined}
  preloadMonoFont
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </Fragment>

  <NavbarWrapper />

  <main id="main-content" class="bg-[var(--surface-page)] text-[var(--text-primary)] min-h-[100svh] w-full pt-24 pb-20 px-4">
    <div class="w-full max-w-[1400px] mx-auto min-w-0">
      <div class="mb-8">
        <a
          id="post-back-link"
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors focus-visible:outline-none group"
        >
          <svg class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Back
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 min-w-0">
        <aside
          class="post-rail hidden lg:flex lg:col-span-3 xl:col-span-3 min-w-0 flex-col sticky top-24 self-start h-[calc(100svh-7rem)] max-h-[calc(100svh-7rem)]"
          data-pagefind-ignore
        >
          {hasToc && (
            <div class="post-rail-index custom-scrollbar min-h-0 shrink overflow-y-auto overscroll-contain pr-3">
              <TableOfContents headings={headings} variant="desktop" />
            </div>
          )}
          <div class="flex min-h-0 w-full grow shrink-0 basis-auto flex-col justify-evenly">
            <div class="shrink-0 pr-3">
              <PostTags tags={post.data.tags} />
            </div>
            <div class="shrink-0 pr-3">
              <ShareButton title={post.data.title} text={post.data.description} url={canonicalUrl} />
            </div>
            <div class="shrink-0 pr-3">
              <AuthorByline avatarSrc={authorAvatar.src} />
            </div>
          </div>
        </aside>

        <article class="min-w-0 max-w-full overflow-hidden lg:col-span-9 xl:col-span-9" data-pagefind-body>
          <header class="mb-10 pb-8 border-b border-[var(--border-subtle)]">
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-[var(--text-primary)] leading-tight mb-4 break-words">
              {post.data.title}
            </h1>

            <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed mb-6 font-normal break-words">
              {post.data.description}
            </p>

            <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm text-[var(--text-tertiary)] font-mono">
              <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
              <span>•</span>
              <span>{readingStats.text}</span>
              {formattedUpdatedDate && (
                <>
                  <span>•</span>
                  <span>Updated {formattedUpdatedDate}</span>
                </>
              )}
              {post.data.draft && (
                <>
                  <span>•</span>
                  <span class="px-2 py-0.5 rounded bg-[var(--danger-quiet)] text-[var(--danger)] border border-[var(--danger)] text-xs uppercase tracking-wider font-semibold">
                    Draft
                  </span>
                </>
              )}
            </div>
          </header>

          <TableOfContents headings={headings} variant="mobile" />

          <div class="lg:hidden mb-8 flex flex-col gap-6" data-pagefind-ignore>
            <PostTags tags={post.data.tags} />
            <ShareButton title={post.data.title} text={post.data.description} url={canonicalUrl} />
            <AuthorByline avatarSrc={authorAvatar.src} />
          </div>

          <div class="post-prose w-full max-w-full min-w-0">
            <LlmBanner />
            <slot />
          </div>

          <figure class="post-signoff" data-pagefind-ignore>
            <img
              src="/blog/mona-hifive.webp"
              alt="Two octocats giving a high five"
              width="128"
              height="48"
              loading="lazy"
              decoding="async"
            />
            <figcaption>You made it to the end!</figcaption>
          </figure>

          <footer class="post-footer border-t border-[var(--border-subtle)]">
            <button
              type="button"
              id="post-back-to-top"
              class="inline-flex cursor-pointer items-center gap-1.5 mb-8 text-xs font-mono uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors focus-visible:outline-none"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="18 15 12 9 6 15"></polyline>
              </svg>
              Back to top
            </button>

            {(prevPost || nextPost) && (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {prevPost ? (
                  <a
                    href={`/blog/${prevPost.id}/`}
                    class="p-4 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:border-[var(--accent)] transition-colors group flex flex-col justify-between"
                  >
                    <span class="text-xs font-mono uppercase tracking-wider text-[var(--text-tertiary)] mb-1">
                      ← Previous
                    </span>
                    <span class="font-heading font-medium text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] line-clamp-2">
                      {prevPost.data.title}
                    </span>
                  </a>
                ) : (
                  <div />
                )}

                {nextPost ? (
                  <a
                    href={`/blog/${nextPost.id}/`}
                    class="p-4 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-card)] hover:border-[var(--accent)] transition-colors group flex flex-col justify-between sm:text-right"
                  >
                    <span class="text-xs font-mono uppercase tracking-wider text-[var(--text-tertiary)] mb-1">
                      Next →
                    </span>
                    <span class="font-heading font-medium text-sm text-[var(--text-primary)] group-hover:text-[var(--accent)] line-clamp-2">
                      {nextPost.data.title}
                    </span>
                  </a>
                ) : (
                  <div />
                )}
              </div>
            )}
          </footer>
        </article>
      </div>
    </div>
  </main>

  <CodeCopy />

  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;

      function setupHeadingAnchors() {
        var headings = document.querySelectorAll(".post-prose h2, .post-prose h3, .post-prose h4");
        headings.forEach(function (h) {
          if (!h.id || h.querySelector(".heading-anchor")) return;
          var anchor = document.createElement("a");
          anchor.className = "heading-anchor";
          anchor.href = "#" + h.id;
          anchor.setAttribute("aria-label", "Anchor link for " + h.textContent);
          anchor.textContent = "#";
          h.appendChild(anchor);
        });
      }

      function wrapTables() {
        var tables = document.querySelectorAll(".post-prose table:not([data-wrapped])");
        tables.forEach(function (table) {
          table.setAttribute("data-wrapped", "true");
          var wrapper = document.createElement("div");
          wrapper.className = "table-scroll-wrapper";
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        });
      }

      function setupBackToTop() {
        var button = document.getElementById("post-back-to-top");
        if (!button || button.dataset.bound) return;
        button.dataset.bound = "true";
        button.addEventListener("click", function () {
          var reduce =
            window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        });
      }

      function stampEntry() {
        var nav = window.portfolioNav;
        var state = window.history.state;
        if (!nav || (state && state.blogBack)) return;
        var from = "";
        var depth = 0;
        try {
          from = sessionStorage.getItem("portfolio_blog_from") || "";
          depth = Number(sessionStorage.getItem("portfolio_blog_depth"));
          sessionStorage.removeItem("portfolio_blog_from");
          sessionStorage.removeItem("portfolio_blog_depth");
        } catch (err) {}
        if (!from || !Number.isFinite(depth) || depth < 1) return;
        var ref = nav.pathOf(document.referrer);
        if (depth === 1 ? ref !== from : !nav.isPost(ref)) return;
        try {
          var next = state && typeof state === "object" ? Object.assign({}, state) : {};
          next.blogBack = { from: from, depth: depth };
          window.history.replaceState(next, "");
        } catch (err) {}
      }

      function setupBackLink() {
        var back = document.getElementById("post-back-link");
        if (!back || back.dataset.bound) return;
        back.dataset.bound = "true";
        back.addEventListener("click", function (event) {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
          var nav = window.portfolioNav;
          if (!nav) return;
          var stamp = window.history.state && window.history.state.blogBack;
          var handled = stamp
            ? nav.returnTo(stamp.from, stamp.depth)
            : nav.returnTo(nav.pathOf(document.referrer), 1);
          if (handled) event.preventDefault();
        });
      }

      function setupInPageLinks() {
        if (document.documentElement.dataset.inPageLinksBound) return;
        document.documentElement.dataset.inPageLinksBound = "true";
        document.addEventListener("click", function (event) {
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          var link = event.target && event.target.closest ? event.target.closest('a[href^="#"]') : null;
          if (!link) return;
          var id = decodeURIComponent(link.getAttribute("href").slice(1));
          var target = id && document.getElementById(id);
          if (!target) return;
          event.preventDefault();
          var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var top = target.getBoundingClientRect().top + window.scrollY - 90;
          window.scrollTo({ top: top, behavior: reduce ? "auto" : "smooth" });
          try {
            window.history.replaceState(window.history.state, "", "#" + id);
          } catch (err) {}
          if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
          target.focus({ preventScroll: true });
        });
      }

      function initArticle() {
        setupHeadingAnchors();
        wrapTables();
        setupBackLink();
        setupBackToTop();
        setupInPageLinks();
      }

      if (document.prerendering) {
        document.addEventListener("prerenderingchange", stampEntry, { once: true });
      } else {
        stampEntry();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initArticle);
      } else {
        initArticle();
      }
      document.addEventListener("astro:page-load", initArticle);
      document.addEventListener("astro:after-swap", initArticle);
    })();
  </script>
</MainLayout>
